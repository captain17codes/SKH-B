  "cost_engine": {
    "principle": "A response plan is feasible only if compatible resources are available AND the estimated response cost fits the scenario budget.",
    "cost_fields": {
      "reference_machine_cost": "sum(machine_hours * verified_reference_rate)",
      "runtime_vehicle_cost": "operator-entered when no verified unit rate exists",
      "runtime_labour_cost": "operator-entered",
      "runtime_material_cost": "operator-entered",
      "other_cost": "operator-entered with reason"
    },
    "formula": "estimated_response_cost = reference_machine_cost + runtime_vehicle_cost + runtime_labour_cost + runtime_material_cost + other_cost",
    "rules": [
      "Never use tender EMD or tender fee as response cost.",
      "Never use ₹1 placeholder tender value as a service cost.",
      "Never silently infer a per-day cost from an annual/package tender.",
      "Store cost source and confidence with every line item.",
      "If a required cost is unknown, mark COST_INCOMPLETE instead of filling zero.",
      "Zero means true zero only when explicitly entered/verified; unknown must be null."
    ],
    "budget_outcomes": [
      "FEASIBLE_WITHIN_BUDGET",
      "FEASIBLE_BUT_COST_INCOMPLETE",
      "RESOURCE_AVAILABLE_BUT_OVER_BUDGET",
      "UNSERVED_RESOURCE_UNAVAILABLE",
      "UNSERVED_NO_ACCESSIBLE_ROUTE"
    ]
  },
