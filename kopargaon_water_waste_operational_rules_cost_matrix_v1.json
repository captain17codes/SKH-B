  "decision_engine_integration": {
    "water_example": {
      "incident": "water_leakage_near_hospital",
      "workflow": [
        "GIS checks hospital proximity and affected population context",
        "compatibility engine requests Plumber + Valveman",
        "operator confirms live team availability",
        "cost engine loads runtime labour/material cost",
        "allocation engine checks road accessibility + budget",
        "result is Served / Delayed / Unserved with Why? evidence"
      ]
    },
    "waste_example": {
      "incident": "heavy_flood_debris_blocking_drain",
      "workflow": [
        "GIS confirms flood/debris response context",
        "engine selects compatible crew + machine candidates",
        "reference machine rates are loaded from 2026 accepted L1 tender rates",
        "operator enters expected machine hours and live availability",
        "cost is calculated transparently",
        "alternative JCB/Poclain configurations can be compared against available budget"
      ]
