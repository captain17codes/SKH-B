    "important_distinction": {
      "statutory_rts": "Official Maharashtra Right to Public Services notified-service timelines and appeal hierarchy.",
      "operational_response_target": "Configurable municipal incident-response target used for dispatch/triage. It is NOT a statutory RTS time limit unless explicitly linked to an official notification."
    },
    "legal_framework_notes": [
      "The Maharashtra Right to Public Services Act, 2015 requires notified services to be delivered within the stipulated time notified by the Public Authority.",
      "A notified service can have a Designated Officer, First Appellate Authority and Second Appellate Authority.",
      "If the applicant remains dissatisfied after first and second appeals, a third appeal may be made to the Maharashtra State Commission for Right to Services.",
      "The statutory time limit may be extended by Government order during elections or natural calamities such as flood or fire; the application must not silently assume an extension."
    ]
  },
