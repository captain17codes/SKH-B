  "escalation_engine": {
    "operational_escalation": [
      {
        "level": 0,
        "name": "Assigned Team",
        "trigger": "incident assigned",
        "actions": [
          "notify team",
          "start operational timer",
          "record acknowledgement"
        ]
      },
      {
        "level": 1,
        "name": "Department Supervisor",
        "trigger": "50% of operational response target consumed without acknowledgement/progress",
        "actions": [
          "notify supervisor",
          "flag at-risk"
        ]
      },
      {
        "level": 2,
        "name": "Municipal Command / Chief Officer Review",
        "trigger": "operational target exceeded or resource remains unavailable",
        "actions": [
          "escalate",
          "require reason",
          "re-optimize resources",
          "notify citizen of delay if configured"
        ]
      },
      {
        "level": 3,
        "name": "District / Emergency Handoff",
        "trigger": "life-safety/disaster threshold or municipal capacity insufficient",
        "actions": [
          "offer/trigger authorized district or state emergency handoff",
          "retain audit record"
        ]
      }
    ],
    "rts_appeal_logic": {
      "applies_only_to": "official notified RTS services",
      "workflow": [
        "Designated Officer",
        "First Appellate Authority",
        "Second Appellate Authority",
        "Third appeal to Maharashtra State Commission for Right to Services"
      ],
      "rule": "Do not automatically file or claim a statutory appeal. The system may show eligibility/status and provide the official escalation path."
    }
  },
  "sla_status_logic": {
    "operational": [
      {
        "status": "ON_TRACK",
        "condition": "elapsed < 0.50 * target"
      },
      {
        "status": "AT_RISK",
        "condition": "elapsed >= 0.50 * target and elapsed < target"
      },
      {
        "status": "OVERDUE",
        "condition": "elapsed >= target"
      }
    ],
    "statutory_rts": [
      {
        "status": "WITHIN_RTS_TIME",
        "condition": "elapsed_days < notified_time_limit_days"
      },
      {
        "status": "RTS_LIMIT_REACHED",
        "condition": "elapsed_days >= notified_time_limit_days"
      }
    ]
  },
  "natural_calamity_rule": {
    "official_basis": "RTS rules permit the concerned administrative department, with required concurrence, to extend stipulated time limits during elections or natural calamities such as flood or fire.",
    "app_rule": "Never auto-extend an RTS deadline merely because a flood scenario is active. Store an extension only when an authorized Government/department order is entered with order reference and dates.",
    "required_fields_for_extension": [
      "government_order_reference",
      "authorized_department",
      "effective_from",
      "effective_to",
      "affected_services",
      "reason"
    ]
  },
